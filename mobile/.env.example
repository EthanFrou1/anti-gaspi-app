# Copier en .env.local (non versionné) et adapter à ta machine.
# Variable publique : elle est intégrée EN CLAIR dans l'app. Jamais de secret ici.
#
# Émulateur Android : http://10.0.2.2:5122
# Simulateur iOS    : http://localhost:5122
# Téléphone réel (Expo Go) : http://<IP de ton PC sur le Wi-Fi>:5122
EXPO_PUBLIC_API_URL=http://10.0.2.2:5122
